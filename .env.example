# Leave blank to use the persistent platform default (Windows: %LOCALAPPDATA%\Ceo\media-data)
CEO_MEDIA_DATA_DIR=

# API route (optional). If blank and provider=auto, V8 uses browser studio routes.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VEO_MODEL=veo-3.1-generate-preview
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Executable/local provider defaults for low-level voice/music and tests.
CEO_MEDIA_PROVIDER=mock
CEO_MEDIA_PROVIDER_FALLBACK=mock
CEO_MEDIA_EXPLICIT_PROVIDER_FALLBACK=false
CEO_MEDIA_AUTO_ALLOW_MOCK=false

# V11 local Google Flow browser driver + V8 browser fallbacks.
# AUTO prefers Gemini API, then authenticated Ceo Flow Browser (video), then Flow Web.
CEO_MEDIA_FLOW_WEB=true
CEO_MEDIA_AI_STUDIO_WEB=true
CEO_MEDIA_FLOW_URL=https://flow.google.com/
CEO_MEDIA_AI_STUDIO_URL=https://aistudio.google.com/
# Optional overrides for the bundled local driver. Leave blank to auto-detect Chrome and managed paths.
CEO_MEDIA_FLOW_CHROME_PATH=
CEO_MEDIA_FLOW_PROFILE_DIR=
CEO_MEDIA_FLOW_STATE_DIR=
CEO_MEDIA_FLOW_HEADLESS=true
CEO_MEDIA_FLOW_STRICT_SETTINGS=false
CEO_MEDIA_FLOW_AUTH_TTL_MS=43200000
CEO_MEDIA_FLOW_POLL_MS=15000
# Optional external Flow Native command override. Blank = bundled scripts/flow-browser-driver.mjs.
CEO_MEDIA_FLOW_NATIVE_COMMAND=
CEO_MEDIA_FLOW_NATIVE_ARGS_JSON=
CEO_MEDIA_FLOW_NATIVE_TIMEOUT_MS=120000
# Browser-mode movies default to CapCut handoff; API/local movies default to FFmpeg.
CEO_MEDIA_BROWSER_FINAL_EDITOR=capcut
CEO_MEDIA_FINAL_EDITOR=ffmpeg

FFMPEG_PATH=
FFPROBE_PATH=
CEO_MEDIA_POLL_MS=10000
CEO_MEDIA_MAX_ATTEMPTS=4
CEO_MEDIA_MAX_POLL_ERRORS=8
CEO_MEDIA_JOB_TIMEOUT_MS=1800000
CEO_MEDIA_RUNNING_LEASE_MS=120000
CEO_MEDIA_AUTO_WORKER=true
CEO_MEDIA_WORKER_INTERVAL_MS=10000
CEO_MEDIA_WORKER_BATCH=20
CEO_MEDIA_MOVIE_VIDEO_CONCURRENCY=1
CEO_MEDIA_MOVIE_STEP_MS=500
FLOW_BRIDGE_MODE=manual
CEO_MEDIA_VOICE_PROVIDER=mock
CEO_MEDIA_MUSIC_PROVIDER=mock
